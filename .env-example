DATABASE_PASSWORD=cadastro_ex

## Se usar PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/nome-do-seu-banco
DATABASE_USERNAME=cadastro_ex_postgres
DATABASE_PASSWORD=cadastro_ex_postgres


