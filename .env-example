## Caso bugue o ID, mude o DB_CLOSE_DELAY para 0
## Não esqueca, de colocar as credenciais corretas no intellij tbm
## Cole no .env na raiz do projeto

DATABASE_URL=jdbc:h2:mem:testdb;DB_CLOSE_ON_EXIT=FALSE;DB_CLOSE_DELAY=0
